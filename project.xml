<?xml version="1.0" encoding="utf-8"?>
<project>
  <name>PasbuildEditor</name>
  <version>1.0.0</version>
  <author>Andrew Haines &lt;andrewd207@github&gt;</author>
  <license>BSD-3-Clause</license>
  <build>
    <packaging>pom</packaging>
  </build>
  <modules>
    <module>termui</module>
    <module>pasbuildeditor</module>
    <module>termui-examples</module>
  </modules>
  <profiles>
    <profile>
      <id>debug</id>
      <defines>
        <define>DEBUG</define>
      </defines>
      <compilerOptions>
        <option>-gw</option>
        <option>-gl</option>
        <option>-O-</option>
      </compilerOptions>
    </profile>
    <profile>
      <id>debug_dwarf</id>
      <defines>
        <define>DEBUG</define>
      </defines>
      <compilerOptions>
        <option>-gw3</option>
        <option>-gl</option>
        <option>-O-</option>
      </compilerOptions>
    </profile>
  </profiles>
</project>
