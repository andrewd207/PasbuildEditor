From d1812b6c279af081cd355564781f347d395a22f4 Mon Sep 17 00:00:00 2001
From: Graeme Geldenhuys <graemeg@gmail.com>
Date: Tue, 12 May 2026 22:48:29 +0100
Subject: [PATCH 1/2] Use PasBuild's resource filtering to inject version
 number.

---
 pasbuildeditor/project.xml                                   | 4 +++-
 pasbuildeditor/src/main/pascal/PasbuildEditor.Version.inc    | 1 -
 pasbuildeditor/src/main/resources/PasbuildEditor.Version.inc | 1 +
 termui/project.xml                                           | 1 -
 4 files changed, 4 insertions(+), 3 deletions(-)
 delete mode 100644 pasbuildeditor/src/main/pascal/PasbuildEditor.Version.inc
 create mode 100644 pasbuildeditor/src/main/resources/PasbuildEditor.Version.inc

diff --git a/pasbuildeditor/project.xml b/pasbuildeditor/project.xml
index 971b63d..9f3c5e6 100644
--- a/pasbuildeditor/project.xml
+++ b/pasbuildeditor/project.xml
@@ -1,7 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <project>
   <name>pasbuildeditor-editor</name>
-  <version>1.0.0</version>
   <author>Andrew Haines &lt;andrewd207@github&gt;</author>
   <license>BSD-3-Clause</license>
   <build>
@@ -15,6 +14,9 @@
       <path condition="DARWIN">src/platform/unix</path>
       <path condition="WINDOWS">src/platform/windows</path>
     </unitPaths>
+    <resources>
+      <filtering>true</filtering>
+    </resources>
   </build>
   <test>
     <framework>auto</framework>
diff --git a/pasbuildeditor/src/main/pascal/PasbuildEditor.Version.inc b/pasbuildeditor/src/main/pascal/PasbuildEditor.Version.inc
deleted file mode 100644
index 6bcb5a0..0000000
--- a/pasbuildeditor/src/main/pascal/PasbuildEditor.Version.inc
+++ /dev/null
@@ -1 +0,0 @@
-APP_VERSION = '1.0.0';
diff --git a/pasbuildeditor/src/main/resources/PasbuildEditor.Version.inc b/pasbuildeditor/src/main/resources/PasbuildEditor.Version.inc
new file mode 100644
index 0000000..ccefeca
--- /dev/null
+++ b/pasbuildeditor/src/main/resources/PasbuildEditor.Version.inc
@@ -0,0 +1 @@
+APP_VERSION = '${project.version}';
diff --git a/termui/project.xml b/termui/project.xml
index 27744c7..99840ed 100644
--- a/termui/project.xml
+++ b/termui/project.xml
@@ -1,7 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <project>
   <name>pasbuildeditor-termui</name>
-  <version>1.0.0</version>
   <author>Andrew Haines &lt;andrewd207@github&gt;</author>
   <license>BSD-3-Clause</license>
   <build>
-- 
2.43.0

