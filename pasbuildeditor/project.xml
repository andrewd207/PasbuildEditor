<?xml version="1.0" encoding="utf-8"?>
<project>
  <name>pasbuildeditor-editor</name>
  <author>Andrew Haines &lt;andrewd207@github&gt;</author>
  <license>BSD-3-Clause</license>
  <build>
    <packaging>application</packaging>
    <mainSource>Main.pas</mainSource>
    <executableName>pb-editor</executableName>
    <resources>
      <filtering>true</filtering>
    </resources>
    <compilerOptions>
      <option>-FF</option>
    </compilerOptions>
  </build>
  <test>
    <framework>auto</framework>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all</option>
      <option>--format=plain</option>
    </frameworkOptions>
  </test>
  <moduleDependencies>
    <module>../termui</module>
  </moduleDependencies>
</project>
