<?xml version="1.0" encoding="utf-8"?>
<project>
  <name>pasbuildeditor-editor</name>
  <version>1.0.0</version>
  <author>Andrew Haines &lt;andrewd207@github&gt;</author>
  <license>BSD-3-Clause</license>
  <build>
    <packaging>application</packaging>
    <mainSource>Main.pas</mainSource>
    <executableName>pb-editor</executableName>
    <manualUnitPaths>true</manualUnitPaths>
    <unitPaths>
      <path>src/main/pascal</path>
      <path condition="LINUX">src/platform/unix</path>
      <path condition="DARWIN">src/platform/unix</path>
      <path condition="WINDOWS">src/platform/windows</path>
    </unitPaths>
  </build>
  <moduleDependencies>
    <module>../termui</module>
  </moduleDependencies>
</project>
