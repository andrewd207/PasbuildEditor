<?xml version="1.0" encoding="utf-8"?>
<project>
  <name>test-app</name>
  <version>1.2.3</version>
  <author>Test Author</author>
  <license>BSD-3-Clause</license>
  <build>
    <packaging>application</packaging>
    <mainSource>Main.pas</mainSource>
    <executableName>my-app</executableName>
    <manualUnitPaths>true</manualUnitPaths>
    <unitPaths>
      <path>src/main/pascal</path>
      <path condition="LINUX">src/platform/unix</path>
    </unitPaths>
    <defines>
      <define>MY_DEFINE</define>
    </defines>
    <compilerOptions>
      <option>-O2</option>
    </compilerOptions>
  </build>
  <test>
    <framework>auto</framework>
    <testSource>TestRunner.pas</testSource>
    <frameworkOptions>
      <option>--all</option>
    </frameworkOptions>
  </test>
  <moduleDependencies>
    <module>../somelib</module>
  </moduleDependencies>
  <dependencies>
    <dependency>
      <name>mylib</name>
      <version>1.0.0</version>
    </dependency>
  </dependencies>
</project>
